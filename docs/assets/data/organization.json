---
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ site.url | append: '/#organization' | jsonify }},
  "name": {{ site.title | jsonify }},
  "url": {{ site.url | jsonify }},
  "logo": {{ '/assets/img/logo.svg' | absolute_url | jsonify }},
  "email": "hello@blackbagsecurity.com",
  "description": {{ site.description | strip | jsonify }},
  "founder": {
    "@type": "Person",
    "name": "Duncan Stirling",
    "jobTitle": "Founder"
  },
  "knowsAbout": [
    "Penetration testing",
    "Red teaming",
    "Secure code review",
    "Reverse engineering",
    "Secure systems engineering",
    "AI security",
    "Agentic security",
    "Vulnerability research",
    "Evidence-led security testing"
  ]
}
