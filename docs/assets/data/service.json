{
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "@id": {{ site.url | append: '/services/#catalog' | jsonify }},
  "name": "Black Bag Security services",
  "url": {{ site.url | append: '/services/' | jsonify }},
  "provider": {
    "@id": {{ site.url | append: '/#organization' | jsonify }}
  },
  "itemListElement": [
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Penetration Testing",
        "description": "Evidence-led testing of applications, APIs, identity, infrastructure, and business logic to establish exploitable conditions and practical remediation priorities."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Red Teaming",
        "description": "Realistic adversary operations that test whether preventive, detective, and response controls materially change the attacker path."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Secure Code Review",
        "description": "Security-focused source review that determines exploitability, root cause, and engineering remediation rather than relying on scanner output alone."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Reverse Engineering",
        "description": "Analysis of binaries, firmware, protocols, and devices when source code, vendor documentation, or conventional testing is insufficient."
      }
    },
    {
      "@type": "Offer",
      "itemOffered": {
        "@type": "Service",
        "name": "Secure Engineering",
        "description": "Design, hardening, and purpose-built security engineering for systems where assessment alone does not solve the problem."
      }
    }
  ]
}
